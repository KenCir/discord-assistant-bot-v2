{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "discord-assistant-bot-v2",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"lint": "prettier --check . && eslint --ext .ts --format=pretty src",
		"deploy": "node --env-file=.env dist/util/deploy.js",
		"deploy:guild": "node --env-file=.env dist/util/deployGuild.js",
		"format": "prettier --write . && eslint --ext .ts --fix --format=pretty src",
		"start": "node --env-file=.env dist/index.js",
		"dev": "NODE_ENV=development node --env-file=.env dist/index.js --enable-source-maps"
	},
	"dependencies": {
		"@discordjs/core": "^2.4.0",
		"bufferutil": "^4.1.0",
		"chart.js": "^4.5.1",
		"chartjs-node-canvas": "^5.0.0",
		"discord.js": "^14.26.4",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.21.0",
		"pino": "^10.3.1",
		"zlib-sync": "^0.1.10"
	},
	"devDependencies": {
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^24.13.1",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-neon": "^0.5.1",
		"eslint-formatter-compact": "^9.0.1",
		"eslint-formatter-pretty": "^7.1.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.8.3",
		"typescript": "~6.0.3",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
